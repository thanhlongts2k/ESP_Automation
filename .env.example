# ============================================================================
# TEMPLATE MẪU CẤU HÌNH DỰ ÁN ESP_AUTOMATION (SAFE FOR GIT PUSH)
# ============================================================================

# 1. Thông Tin Wi-Fi Kết Nối ESP32
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# 2. Thông Tin MQTT Server (Nginx SSL Stream Proxy)
MQTT_SERVER="api-vending.doanhnghiep.com"
MQTT_PORT=8883
MQTT_USER=""
MQTT_PASSWORD=""

# 3. Thông Tin Định Danh Thiết Bị & Topics
DEVICE_ID="ESP32_Automation_01"
HOSTNAME="esp32-automation"
FIRMWARE_VERSION="1.0.0"

TOPIC_SENSOR_DATA="esp32/${DEVICE_ID}/sensors"
TOPIC_STATUS="esp32/${DEVICE_ID}/status"
TOPIC_CONTROL_RELAY1="esp32/${DEVICE_ID}/control/relay1"
TOPIC_CONTROL_RELAY2="esp32/${DEVICE_ID}/control/relay2"
TOPIC_OTA_TRIGGER="esp32/${DEVICE_ID}/system/ota_trigger"
